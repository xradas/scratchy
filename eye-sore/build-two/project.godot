; Godot 4.7.2 calibration foundation. Identity gate remains pending.
config_version=5

[application]
config/name="Eyesore · calibration foundation"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[audio]
buses/default_bus_layout="res://resources/default_bus_layout.tres"

[editor]
; Avoid the observed 4.7.2 threaded audio reimport crash.
import/use_multiple_threads=false
